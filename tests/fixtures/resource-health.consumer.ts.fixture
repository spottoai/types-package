import {
  ProviderName,
  RESOURCE_HEALTH_EVENTS_PORTAL_FILE_NAME,
  RESOURCE_HEALTH_AVAILABILITY_STATUSES_PORTAL_FILE_NAME,
  type AzureResourceHealthEventPortalCollection,
  type AzureResourceHealthAvailabilityStatusPortalCollection,
  type ResourceHealthEventPortalCollection,
  type ResourceHealthAvailabilityStatusPortalCollection,
  type ResourceHealthSourceCoverage,
  type ResourceHealthEventStatus,
  type ResourceHealthPostIncidentReview,
  type PortalHealthEventsSummary,
} from '@spottoai/types-package';

const coverage: ResourceHealthSourceCoverage = {
  sourceId: 'aws-health',
  support: 'unsupported',
  attempt: 'not-attempted',
  coverage: 'none',
  freshness: 'unknown',
  reasonCode: 'source-unavailable',
};
const providerScope = { providerName: ProviderName.Aws, providerScopeId: '123456789012' };
const events: ResourceHealthEventPortalCollection = {
  schemaVersion: 1,
  generatedAt: '2026-10-05T00:00:00.000Z',
  subscriptionId: providerScope.providerScopeId,
  providerScope,
  source: 'aws-health',
  coverage: { sources: [coverage] },
  events: [],
};
const availability: ResourceHealthAvailabilityStatusPortalCollection = {
  schemaVersion: 1,
  generatedAt: events.generatedAt,
  subscriptionId: providerScope.providerScopeId,
  providerScope,
  source: 'native-resource-status',
  coverage: { sources: [coverage] },
  statuses: [],
};

declare const azureEvents: AzureResourceHealthEventPortalCollection;
declare const azureAvailability: AzureResourceHealthAvailabilityStatusPortalCollection;
const commonEvents: ResourceHealthEventPortalCollection = azureEvents;
const commonAvailability: ResourceHealthAvailabilityStatusPortalCollection = azureAvailability;
const upcoming: ResourceHealthEventStatus = 'Upcoming';
const review: ResourceHealthPostIncidentReview = { howDidProviderRespond: 'Mitigation completed.' };
declare const summary: PortalHealthEventsSummary;
const upcomingCount: number | undefined = summary.upcomingEvents;

void [
  RESOURCE_HEALTH_EVENTS_PORTAL_FILE_NAME,
  RESOURCE_HEALTH_AVAILABILITY_STATUSES_PORTAL_FILE_NAME,
  events,
  availability,
  commonEvents,
  commonAvailability,
  upcoming,
  review,
  upcomingCount,
];
